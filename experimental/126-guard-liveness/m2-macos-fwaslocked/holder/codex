#!/usr/bin/env node
// Synthetic actual holder named `codex` (#127 research, M2). Derived from the
// #100 fixture. Takes coordination and then the thread flock, both with
// bounded nonblocking polling (real Codex blocks on coordination), and keeps
// the thread lock until stdin EOF or FIXTURE_LIFETIME_MS, whichever is first.
// Lifetime expiry exits with code 3 so the runner can tell it apart.
import fs from 'node:fs'
import { createRequire } from 'node:module'
import path from 'node:path'
import process from 'node:process'
import { setTimeout } from 'node:timers'

const require = createRequire(process.env.FIXTURE_REQUIRE_FROM)
const { flockSync } = require('fs-ext-extra-prebuilt')
const sleeper = new Int32Array(new SharedArrayBuffer(4))

function acquire(fd, budgetMs) {
  const until = Date.now() + budgetMs
  while (true) {
    try {
      flockSync(fd, 'exnb')
      return
    } catch (error) {
      if (error.code !== 'EAGAIN' && error.code !== 'EWOULDBLOCK') throw error
    }
    if (Date.now() > until) throw new Error('holder acquisition timed out')
    Atomics.wait(sleeper, 0, 0, 5)
  }
}

const lockPath = process.env.FIXTURE_LOCK_PATH
const guard = fs.openSync(path.join(path.dirname(lockPath), '.coordination.lock'), 'r')
acquire(guard, 2000)
const thread = fs.openSync(lockPath, 'r+')
acquire(thread, 2000)
flockSync(guard, 'un')
fs.closeSync(guard)
process.stdout.write('ready\n')
setTimeout(() => { fs.closeSync(thread); process.exit(3) }, Number(process.env.FIXTURE_LIFETIME_MS ?? 60000)).unref()
process.stdin.resume()
process.stdin.on('end', () => {
  fs.closeSync(thread)
  process.exit(0)
})
