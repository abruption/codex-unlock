#!/usr/bin/env node
// Former holder named `codex` (#127 research, M2). Acquires the thread flock
// under coordination like Codex v0.162.1, releases it with LOCK_UN but keeps
// the descriptor open until stdin EOF. Its open file description therefore
// keeps the sticky FWASLOCKED bit while another process holds the lock.
import fs from 'node:fs'
import { createRequire } from 'node:module'
import path from 'node:path'
import process from 'node:process'

const require = createRequire(process.env.FIXTURE_REQUIRE_FROM)
const { flockSync } = require('fs-ext-extra-prebuilt')

const lockPath = process.env.FIXTURE_LOCK_PATH
const guard = fs.openSync(path.join(path.dirname(lockPath), '.coordination.lock'), 'r')
flockSync(guard, 'exnb')
const thread = fs.openSync(lockPath, 'r+')
flockSync(thread, 'exnb')
flockSync(thread, 'un')
flockSync(guard, 'un')
fs.closeSync(guard)
process.stdout.write('ready\n')
process.stdin.resume()
process.stdin.on('end', () => {
  fs.closeSync(thread)
  process.exit(0)
})
