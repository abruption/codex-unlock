{
  "name": "codex-unlock",
  "version": "0.1.1",
  "description": "Diagnose Codex thread writer locks and safely release completed idle sessions.",
  "type": "module",
  "bin": {
    "codex-unlock": "dist/cli.js"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*.js",
    "schemas/**/*.json",
    "docs/json-v1.md",
    "docs/upstream-handoff-proposal.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "lint": "eslint .",
    "pretest": "npm run build",
    "prepare": "npm run build",
    "smoke:package": "npm run build && node scripts/package-smoke.mjs",
    "test": "node --test test/*.test.mjs",
    "typecheck": "npm run check"
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "keywords": [
    "codex",
    "codex-cli",
    "diagnostics",
    "lock",
    "session",
    "cli",
    "unlock"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abruption/codex-unlock.git"
  },
  "homepage": "https://github.com/abruption/codex-unlock#readme",
  "bugs": {
    "url": "https://github.com/abruption/codex-unlock/issues"
  },
  "author": "abruption",
  "license": "MIT",
  "dependencies": {
    "fs-ext-extra-prebuilt": "^2.2.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.15.0",
    "ajv": "^8.20.0",
    "eslint": "^10.0.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.62.1"
  }
}
