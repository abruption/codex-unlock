#!/usr/bin/env node

import fs from "node:fs";
import path from "node:path";
import readline from "node:readline";

import { flockSync } from "fs-ext-extra-prebuilt";

const lockPaths = process.argv.slice(2);
if (lockPaths.length === 0) {
  process.stderr.write("lock path required\n");
  process.exit(64);
}

const descriptors = [];
function acquire(lockPath) {
  const guardPath = path.join(path.dirname(lockPath), ".coordination.lock");
  const guard = fs.existsSync(guardPath) ? fs.openSync(guardPath, "r") : null;
  if (guard !== null) flockSync(guard, "ex");
  try {
    const fd = fs.openSync(lockPath, "r+");
    flockSync(fd, "exnb");
    descriptors.push(fd);
  } finally {
    if (guard !== null) {
      flockSync(guard, "un");
      fs.closeSync(guard);
    }
  }
}

for (const lockPath of lockPaths) acquire(lockPath);

const commands = readline.createInterface({ input: process.stdin });
commands.on("line", (line) => {
  const command = JSON.parse(line);
  if (command.action === "acquire") acquire(command.path);
  else if (command.action === "title") process.title = command.value;
  else throw new Error(`unknown fixture command: ${command.action}`);
  process.stdout.write(`ack:${command.id}\n`);
});
let dropping = false;
process.on("SIGTERM", () => {
  if (dropping) return;
  dropping = true;
  const guardPath = path.join(path.dirname(lockPaths[0]), ".coordination.lock");
  const guard = fs.existsSync(guardPath) ? fs.openSync(guardPath, "r") : null;
  if (guard !== null) flockSync(guard, "ex");
  if (process.env.CODEX_FIXTURE_DROP_GUARD_READY) {
    fs.writeFileSync(process.env.CODEX_FIXTURE_DROP_GUARD_READY, "ready\n");
  }
  const finish = () => {
    if (process.env.CODEX_FIXTURE_SIGTERM_MARKER) {
      fs.writeFileSync(process.env.CODEX_FIXTURE_SIGTERM_MARKER, "terminated\n");
    }
    for (const fd of descriptors) fs.closeSync(fd);
    if (guard !== null) {
      flockSync(guard, "un");
      fs.closeSync(guard);
    }
    if (process.env.CODEX_FIXTURE_SIGTERM_BREAK_LOCK_PATH === "1") {
      const lockDirectory = path.dirname(lockPaths[0]);
      fs.renameSync(lockDirectory, `${lockDirectory}.moved`);
      fs.writeFileSync(lockDirectory, "not a directory");
    }
    process.exit(0);
  };
  const holdMs = Number(process.env.CODEX_FIXTURE_DROP_GUARD_MS ?? 0);
  if (holdMs > 0) setTimeout(finish, holdMs);
  else finish();
});
process.stdout.write("ready\n");
setInterval(() => {}, 1_000);
